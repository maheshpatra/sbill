# Billflow API. Copy to api/.env (or the repo root). Never commit real secrets.
# Project ref: raflrreyawwexjerfqpc  region: ap-south-1 (Mumbai)
# URL: https://raflrreyawwexjerfqpc.supabase.co

SUPABASE_URL=https://raflrreyawwexjerfqpc.supabase.co
# Publishable (anon) key. Safe to ship in a browser. This project uses the sb_publishable_ form.
SUPABASE_ANON_KEY=sb_publishable_HnSYucho5rhb57GQGXHc8A_jrrXAKDC
# Secret. Dashboard → Project Settings → API. Placeholder only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# HS256 shared secret (legacy JWT). Leave as the placeholder and set SUPABASE_JWKS_URL
# instead when the project signs tokens with the asymmetric keys (newer Supabase projects).
SUPABASE_JWT_SECRET=your-jwt-secret
# SUPABASE_JWKS_URL=https://raflrreyawwexjerfqpc.supabase.co/auth/v1/.well-known/jwks.json

# Transaction pooler (port 6543) for the running API if you open a direct Postgres client.
# Use the session pooler (port 5432) for migrations and prepared statements.
# User is postgres.raflrreyawwexjerfqpc. Password stays a placeholder.
DATABASE_URL=postgresql://postgres.raflrreyawwexjerfqpc:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres
# DATABASE_URL_SESSION=postgresql://postgres.raflrreyawwexjerfqpc:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

PORT=4317
# Comma-separated browser origins. Omit to reflect the request origin (local dev).
# CORS_ORIGINS=http://127.0.0.1:4318,http://localhost:4318
CRON_SECRET=your-cron-secret
CRON_ENABLED=false
APP_DOMAIN=billflow.com
ROOT_DOMAIN=billflow.com
PUBLIC_APP_URL=http://127.0.0.1:4318

# Image storage. The platform setting storage_provider is supabase, cloudinary, or r2.
# Supabase Storage is the default and uses SUPABASE_URL. No extra key.
# Cloudinary signed uploads. Prefer the dashboard (PATCH /admin/settings cloudinary).
# Those database values override these env vars. The API secret is write-only.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Optional R2. If storage_provider is r2 or cloudinary but that env is missing, presign uses Supabase.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=https://assets.example.com

# WhatsApp Cloud API (Meta). Per-tenant token is stored in whatsapp_settings and is not returned by the API.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_NAME=invoice_share
# WHATSAPP_VERIFY_TOKEN=replace-with-a-long-random-string

# SMS. MSG91 needs a DLT-approved template id. Twilio is the alternate provider.
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=BILFLW
# MSG91_DLT_TEMPLATE_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# Email. Set one provider. SMTP_PASS and RESEND_API_KEY are secrets.
# RESEND_API_KEY=
# RESEND_FROM=invoices@billflow.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=invoices@billflow.com

# Encrypts each tenant's Razorpay key secret and webhook secret. 32 bytes, base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# PAYMENT_SECRETS_KEY=

# Platform billing. These keys charge tenants for a billflow plan. They are not the tenant's own Razorpay account.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# PLATFORM_GSTIN=
# PLATFORM_STATE_CODE=27
# BILLING_DEV_ACTIVATE=false

# e-invoice stub. Leave unset for the documented not-connected response. "success" writes a fake IRN.
# EINVOICE_STUB=
