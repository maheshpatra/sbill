# Absolute URL of the dashboard sign-up page. CTAs on the marketing site go here.
NEXT_PUBLIC_DASHBOARD_URL=http://127.0.0.1:4319/signup

# Public origin of this site. Used for canonical and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:4318

# Apex that tenant subdomains hang off. Middleware reads ROOT_DOMAIN.
ROOT_DOMAIN=billflow.com
NEXT_PUBLIC_ROOT_DOMAIN=billflow.com
DASHBOARD_HOST=app.billflow.com

# Anon key is enough for get_site_by_host. No service role in the browser app.
